{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "comment": "CA Trader Laptop Server Configuration - Highly portable across Windows machines",
  "server": {
    "host": "127.0.0.1",
    "port": 8000,
    "log_level": "info",
    "event_loop_policy": "WindowsSelectorEventLoopPolicy",
    "reload": false
  },
  "database": {
    "canonical_file": "ca_trader.sqlite3",
    "backup_dir": "server_host/backups",
    "auto_backup_on_start": true,
    "max_backups_to_retain": 15
  },
  "tunnel": {
    "enabled": true,
    "provider": "cloudflare",
    "mode": "named",
    "named_tunnel": {
      "tunnel_name": "catrader-laptop",
      "tunnel_id": "5176ca7a-88f2-46f7-a644-147f47708213",
      "tunnel_token": "eyJhIjoiYTUzY2U1Yjg0MDZhNmQwMzA3ZTcyZWVmNWYzNDdmNDEiLCJ0IjoiNTE3NmNhN2EtODhmMi00NmY3LWE2NDQtMTQ3ZjQ3NzA4MjEzIiwicyI6IlpPbzRZZEo2WTZ3WWVvQ29uYU80L3NNZjZRM05NNElqTUdRY2ZWcE1uRzg9In0=",
      "custom_hostname": "catrader.site"
    },
    "binary_path": "server_host/bin/cloudflared.exe"
  },
  "power_management": {
    "prevent_system_sleep_while_running": true,
    "recommended_windows_power_settings": {
      "sleep_when_plugged_in": "Never",
      "lid_close_action_when_plugged_in": "Do nothing"
    }
  }
